# HAL parts without an implementation continue to accept only none.
set(hal_includes "")
set(hal_factories "")
set(hal_libraries "")
foreach(part INPUT AUDIO POWER WIFI BLUETOOTH HAPTICS STORAGE)
    set(available none)
    set(default none)
    if(part STREQUAL "POWER" OR part STREQUAL "STORAGE")
        list(APPEND available sim)
        if(OAP_BUILD_SIM)
            set(default sim)
        endif()
    endif()
    set(OAP_HAL_${part} "${default}" CACHE STRING "Built HAL ${part} backend")
    set_property(CACHE OAP_HAL_${part} PROPERTY STRINGS ${available})
    if(NOT OAP_HAL_${part} IN_LIST available)
        message(FATAL_ERROR "Unknown or unavailable HAL ${part} backend '${OAP_HAL_${part}}'; available: ${available}")
    endif()
    if(OAP_HAL_${part} STREQUAL "sim")
        string(TOLOWER "${part}" lower)
        if(part STREQUAL "POWER")
            set(type Power)
        else()
            set(type Storage)
        endif()
        add_library(oaphal-sim-${lower} STATIC ${CMAKE_CURRENT_LIST_DIR}/../../app/hal/sim/${lower}.cpp)
        target_link_libraries(oaphal-sim-${lower} PUBLIC oapcore)
        list(APPEND hal_libraries oaphal-sim-${lower})
        string(APPEND hal_includes "#include \"hal/sim/${lower}.h\"\n")
        string(APPEND hal_factories "    parts.${lower} = makeSim${type}();\n")
    endif()
endforeach()
configure_file(${CMAKE_CURRENT_LIST_DIR}/registry.cpp.in
               ${CMAKE_CURRENT_BINARY_DIR}/generated/hal_registry.cpp @ONLY)
add_library(oaphal STATIC ${CMAKE_CURRENT_BINARY_DIR}/generated/hal_registry.cpp)
target_link_libraries(oaphal PUBLIC oapcore ${hal_libraries})
target_compile_options(oaphal PRIVATE -Wall -Wextra)
